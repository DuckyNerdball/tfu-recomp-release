+               buffer ? HexWords(buffer, 0x40) : std::string("-"));
+  // bioshock2mp storage probe: chase pointers one/two levels deep so the request-block layout can be mapped.
+  if (!buffer || (message & 0xFFFF0000) != 0x00050000) return;
+  uint32_t roots[16]; uint32_t nroots = 0;
+  for (uint32_t i = 0; i < 0x40 && nroots < 16; i += 4) roots[nroots++] = rex::memory::load_and_swap<uint32_t>(buffer + i);
+  for (uint32_t r = 0; r < nroots; ++r) {
+    uint32_t a = roots[r];
+    if (!GuestReadable(mem, a, 0x100)) continue;
+    auto hp = mem->TranslateVirtual<const uint8_t*>(a);
+    REXKRNL_WARN("fake_live:   [+{:02X}] {:08X}: {} | u16 '{}'", r * 4, a, HexWords(hp, 0x100), Utf16Peek(hp, 64));
+    if ((message & 0xFFFF) == 0x8035) continue;   // path builder: one level is enough
+    for (uint32_t j = 0; j < 0x100; j += 4) {
+      uint32_t b = rex::memory::load_and_swap<uint32_t>(hp + j);
+      if (b == a || !GuestReadable(mem, b, 0x40)) continue;
+      auto hb = mem->TranslateVirtual<const uint8_t*>(b);
+      REXKRNL_WARN("fake_live:     [+{:02X}+{:02X}] {:08X}: {} | u16 '{}'", r * 4, j, b, HexWords(hb, 0x40), Utf16Peek(hb, 48));
