+static bool GuestReadable1(rex::memory::Memory* mem, uint32_t ptr, uint32_t n) {
+  auto host = mem->TranslateVirtual(ptr);
+  size_t len = n;
+  rex::memory::PageAccess acc{};
+  if (!rex::memory::QueryProtect(host, len, acc)) return false;
+  return (uint32_t(acc) & uint32_t(rex::memory::PageAccess::kReadOnly)) != 0;
+}
+static bool GuestReadable(rex::memory::Memory* mem, uint32_t ptr, uint32_t n) {
+  if (ptr < 0x10000 || ptr >= 0xE0000000) return false;
+  return GuestReadable1(mem, ptr, 1) && GuestReadable1(mem, ptr + n - 1, 1);
+}
+static std::string HexWords(const uint8_t* p, uint32_t n) {
+  std::string hx;
+  for (uint32_t i = 0; i < n; i += 4) hx += fmt::format("{}{:08X}", i ? " " : "", rex::memory::load_and_swap<uint32_t>(p + i));
+  return hx;
+}
+static std::string Utf16Peek(const uint8_t* p, uint32_t maxch) {
+  std::string out;
+  for (uint32_t i = 0; i < maxch; ++i) {
+    uint16_t c = rex::memory::load_and_swap<uint16_t>(p + i * 2);
+    if (!c) break;
+    out += (c >= 0x20 && c < 0x7F) ? char(c) : (c == '\n' ? '|' : '?');
+  }
+  return out;
+}
+static void DumpLiveBuffer(rex::memory::Memory* mem, uint32_t message, uint32_t buffer_ptr, const uint8_t* buffer, uint32_t buffer_length) {
